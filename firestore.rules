rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['ia.asep12@gmail.com', 'admin@neuronan.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection rules
    match /users/{userId} {
      // Users can read their own profile; Admins can read all profiles.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Anyone can register their own profile.
      // Enforce proper role/status based on verified email from auth token.
      allow create: if isSignedIn() && request.auth.uid == userId 
        && incoming().namaLengkap is string && incoming().namaLengkap.size() <= 100
        && incoming().email == request.auth.token.email
        && incoming().whatsapp is string && incoming().whatsapp.size() <= 20
        && incoming().whatsapp.matches('^[0-9]+$')
        && (
          // Standard user registration
          (incoming().role == 'user' && incoming().status == 'PENDING') ||
          // Default admin registration auto-approval based on auth token
          ((request.auth.token.email == 'ia.asep12@gmail.com' || request.auth.token.email == 'admin@neuronan.com') && incoming().role == 'admin' && incoming().status == 'ACTIVE')
        );

      // Users can update their own non-sensitive details; Admins can update any profile.
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId && (
              incoming().role == existing().role
              && incoming().status == existing().status
              && incoming().email == existing().email
              && incoming().namaLengkap is string && incoming().namaLengkap.size() <= 100
              && incoming().whatsapp is string && incoming().whatsapp.size() <= 20
              && incoming().whatsapp.matches('^[0-9]+$')
              && incoming().diff(existing()).affectedKeys().hasOnly(['namaLengkap', 'whatsapp'])
          )
        )
      );

      // Allow Admins to delete user profiles
      allow delete: if isAdmin();
    }

    // Settings Collection rules
    match /settings/{settingId} {
      // Anyone can read whatsapp and price settings (for landing page & countdowns)
      // Authenticated users can read payment settings
      allow read: if (settingId == 'whatsapp' || settingId == 'price') || isSignedIn();

      // Only Admins can modify settings.
      allow write: if isAdmin();
    }

    // Showcases Collection rules
    match /showcases/{showcaseId} {
      // Anyone can read published showcases
      allow read: if true;
      
      // Only admins can write
      allow write: if isAdmin();
    }

    // Affiliates Collection rules
    match /affiliates/{affiliateId} {
      // Anyone can read affiliates (needed for referral link resolution or leaderboard)
      // Admins and owners can read their full record
      allow read: if true;

      // An authenticated user can register their affiliate profile (or admin)
      allow create: if isSignedIn() && (request.auth.uid == affiliateId || isAdmin());

      // Owner can update their bank details/clicks, Admin can update everything (payouts, status)
      allow update: if isSignedIn() && (request.auth.uid == affiliateId || isAdmin());

      // Admin can delete
      allow delete: if isAdmin();
    }

    // Affiliate Referrals Collection rules
    match /affiliate_referrals/{referralId} {
      // Admins can read and write all referrals
      // Affiliates can read their own referrals
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.affiliateId == request.auth.uid
      );

      // Authenticated users can create referral transaction when registering, or Admin
      allow create: if isSignedIn();

      // Only admins can update (approve/reject/pay commission)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }
  }
}
