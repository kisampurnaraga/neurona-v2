rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email in ['ia.asep12@gmail.com', 'admin@neuronan.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection rules
    match /users/{userId} {
      // Users can read their own profile; Admins can read all profiles.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Anyone can register their own profile.
      allow create: if isSignedIn() && request.auth.uid == userId 
        && incoming().namaLengkap is string && incoming().namaLengkap.size() <= 100
        && incoming().email == request.auth.token.email
        && incoming().whatsapp is string && incoming().whatsapp.size() <= 20
        && incoming().whatsapp.matches('^[0-9]+$')
        && (
          // Standard user registration must be user/PENDING
          (incoming().role == 'user' && incoming().status == 'PENDING') ||
          // Admin registration auto-approval based on verified token email
          (isAdmin() && incoming().role == 'admin' && incoming().status == 'ACTIVE')
        );

      // Users can update non-sensitive fields; Admins can update any profile (e.g. approve status).
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId && (
              incoming().role == existing().role
              && incoming().status == existing().status
              && incoming().email == existing().email
              && incoming().namaLengkap is string && incoming().namaLengkap.size() <= 100
              && incoming().whatsapp is string && incoming().whatsapp.size() <= 20
              && incoming().whatsapp.matches('^[0-9]+$')
              && incoming().diff(existing()).affectedKeys().hasOnly(['namaLengkap', 'whatsapp'])
          )
        )
      );

      // Allow Admins to delete user profiles
      allow delete: if isAdmin();
    }

    // Settings Collection rules
    match /settings/{settingId} {
      // Anyone can read whatsapp and price settings (for landing page & countdowns)
      // Authenticated users can read payment settings & aistudio settings
      allow read: if (settingId == 'whatsapp' || settingId == 'price') || isSignedIn();

      // Only Admins can modify settings.
      allow write: if isAdmin();
    }

    // Showcases Collection rules
    match /showcases/{showcaseId} {
      // Anyone can read published showcases
      allow read: if true;
      
      // Only admins can write
      allow write: if isAdmin();
    }

    // Affiliates Collection rules
    match /affiliates/{affiliateId} {
      // Anyone can read basic affiliate profile for referral resolution
      allow read: if true;

      // An authenticated user can register their affiliate profile (or admin)
      allow create: if isSignedIn() && (request.auth.uid == affiliateId || isAdmin());

      // Owner can update bank details or stats; Admin can update everything
      allow update: if isSignedIn() && (request.auth.uid == affiliateId || isAdmin());

      // Admin can delete
      allow delete: if isAdmin();
    }

    // Affiliate Referrals Collection rules
    match /affiliate_referrals/{referralId} {
      // Admins can read all referrals; Affiliates can read their own referrals
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.affiliateId == request.auth.uid ||
        resource.data.buyerUserId == request.auth.uid
      );

      // Creating a referral requires strict server validation or default safe pending status
      allow create: if isSignedIn() 
        && incoming().status == 'pending'
        && incoming().commissionRate == 40
        && (incoming().productPrice == 99000 || incoming().productPrice == 499000)
        && incoming().commissionAmount == (incoming().productPrice * 40 / 100);

      // Only admins can update (approve/reject/pay commission)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }
  }
}
