rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email in ['ia.asep12@gmail.com', 'admin@neuronan.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection rules
    match /users/{userId} {
      // Users can read their own profile; Admins can read all profiles.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Anyone can register their own profile.
      allow create: if isSignedIn() && request.auth.uid == userId 
        && incoming().namaLengkap is string && incoming().namaLengkap.size() <= 100
        && incoming().email == request.auth.token.email
        && incoming().whatsapp is string && incoming().whatsapp.size() <= 20
        && incoming().whatsapp.matches('^[0-9]+$')
        && (
          // Standard user registration must be user/PENDING
          (incoming().role == 'user' && incoming().status == 'PENDING') ||
          // Admin registration auto-approval ONLY for hardcoded admin emails
          (request.auth.token.email in ['ia.asep12@gmail.com', 'admin@neuronan.com'] && incoming().role == 'admin' && incoming().status == 'ACTIVE')
        );

      // Users can update non-sensitive fields; Admins can update any profile (e.g. approve status/role).
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId && (
              incoming().role == existing().role
              && incoming().status == existing().status
              && incoming().email == existing().email
              && incoming().namaLengkap is string && incoming().namaLengkap.size() <= 100
              && incoming().whatsapp is string && incoming().whatsapp.size() <= 20
              && incoming().whatsapp.matches('^[0-9]+$')
              && incoming().diff(existing()).affectedKeys().hasOnly(['namaLengkap', 'whatsapp'])
          )
        )
      );

      // Allow Admins to delete user profiles
      allow delete: if isAdmin();
    }

    // Settings Collection rules
    match /settings/{settingId} {
      // Anyone can read whatsapp, price, and payment settings (for landing page, invoice & countdowns)
      // Authenticated users can read payment settings & aistudio settings
      allow read: if (settingId == 'whatsapp' || settingId == 'price' || settingId == 'payment') || isSignedIn();

      // Only Admins can modify settings.
      allow write: if isAdmin();
    }

    // Invoices Collection rules
    match /invoices/{invoiceId} {
      // Users can read their own invoices; Admins can read all
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Direct client creation is STRICTLY DENIED (creation MUST go through server endpoint)
      allow create: if false;

      // Only admins can update (verify/reject)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Showcases Collection rules
    match /showcases/{showcaseId} {
      // Anyone can read published showcases
      allow read: if true;
      
      // Only admins can write
      allow write: if isAdmin();
    }

    // Affiliates Collection rules
    match /affiliates/{affiliateId} {
      // Anyone can read basic affiliate profile for referral resolution
      allow read: if true;

      // An authenticated user can register their affiliate profile (or admin)
      allow create: if isSignedIn() 
        && (request.auth.uid == affiliateId || isAdmin())
        && incoming().pendingEarnings == 0
        && incoming().totalEarnings == 0
        && incoming().paidEarnings == 0
        && incoming().totalClicks == 0;

      // Owner can update ONLY non-financial details (bank info, whatsapp); Admin can update everything
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == affiliateId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['bankName', 'accountNumber', 'accountHolder', 'namaPemilikBank', 'whatsapp', 'updatedAt'])
        )
      );

      // Admin can delete
      allow delete: if isAdmin();
    }

    // Affiliate Referrals Collection rules
    match /affiliate_referrals/{referralId} {
      // Admins can read all referrals; Affiliates can read their own referrals
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.affiliateId == request.auth.uid ||
        resource.data.buyerUserId == request.auth.uid
      );

      // Direct client creation is STRICTLY DENIED (creation MUST go through server endpoint)
      allow create: if false;

      // Only admins can update (approve/reject/pay commission)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Creator Autopilot Profiles
    match /creator_autopilot_profiles/{profileUserId} {
      allow read: if isSignedIn() && (request.auth.uid == profileUserId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == profileUserId || isAdmin());
    }

    // Creator Opportunities
    match /creator_opportunities/{oppId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
    }

    // Creator Content Plans
    match /creator_content_plans/{planId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
    }

    // Creator Published Content
    match /creator_published_content/{contentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
    }

    // Creator Analytics & Learning
    match /creator_analytics/{docId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /creator_learning/{docId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Astra Usage Logs - Server-authoritative writes only (Admin SDK)
    match /astra_usage/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
  }
}
