rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email in ['ia.asep12@gmail.com', 'admin@neuronan.com']
      );
    }

    function isValidImageOrVideo() {
      return request.resource.size < 50 * 1024 * 1024 // max 50MB
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif)') ||
          request.resource.contentType.matches('video/(mp4|webm|quicktime)')
        );
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public showcases directory
    match /showcases/{fileName} {
      // Anyone can view showcase files
      allow read: if true;

      // Only admins can upload showcase files with valid format/size
      allow write: if isAdmin() && isValidImageOrVideo();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // User uploads directory
    match /users/{userId}/{fileName} {
      // User can read/write their own uploads or admin
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
