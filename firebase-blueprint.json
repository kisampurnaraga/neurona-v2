{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about a registered user or administrator.",
      "type": "object",
      "properties": {
        "namaLengkap": {
          "type": "string",
          "description": "The user's full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's unique email address"
        },
        "whatsapp": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "WhatsApp number containing digits only"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACTIVE", "REJECTED"],
          "description": "Account approval status"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "The authorization role of the user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp of user registration"
        }
      },
      "required": ["namaLengkap", "email", "whatsapp", "status", "role", "createdAt"]
    },
    "PaymentSetting": {
      "title": "Payment Settings",
      "description": "Bank account coordinates for user registration fees.",
      "type": "object",
      "properties": {
        "bankName": {
          "type": "string",
          "description": "Name of the target bank"
        },
        "accountNumber": {
          "type": "string",
          "description": "Account number for payment transfer"
        },
        "accountHolder": {
          "type": "string",
          "description": "Name of the bank account holder"
        }
      },
      "required": ["bankName", "accountNumber", "accountHolder"]
    },
    "Affiliate": {
      "title": "Affiliate Profile",
      "description": "Affiliate registration and performance metrics.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userWhatsapp": { "type": "string" },
        "referralCode": { "type": "string" },
        "commissionRate": { "type": "number" },
        "productPrice": { "type": "number" },
        "totalClicks": { "type": "number" },
        "totalReferrals": { "type": "number" },
        "successfulSales": { "type": "number" },
        "totalEarnings": { "type": "number" },
        "pendingEarnings": { "type": "number" },
        "withdrawnEarnings": { "type": "number" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountHolder": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "userName", "userEmail", "referralCode", "commissionRate"]
    },
    "AffiliateReferral": {
      "title": "Affiliate Referral Record",
      "description": "Log of user registrations referred by an affiliate.",
      "type": "object",
      "properties": {
        "affiliateId": { "type": "string" },
        "affiliateCode": { "type": "string" },
        "buyerUserId": { "type": "string" },
        "buyerName": { "type": "string" },
        "buyerEmail": { "type": "string" },
        "productPrice": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["affiliateId", "affiliateCode", "buyerUserId", "commissionAmount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by their Firebase Auth UID."
    },
    "/settings/{settingId}": {
      "schema": "PaymentSetting",
      "description": "Admin configurations such as bank account credentials."
    },
    "/affiliates/{affiliateId}": {
      "schema": "Affiliate",
      "description": "Affiliate profile records indexed by UID."
    },
    "/affiliate_referrals/{referralId}": {
      "schema": "AffiliateReferral",
      "description": "Referral transactions and commission logs."
    }
  }
}
